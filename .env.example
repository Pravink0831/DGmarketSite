# =====================================================================
# NEUFORM · Environment variable template
# ---------------------------------------------------------------------
# Copy this file to `.env` and fill real values. `.env` is git-ignored.
# In Vite, ONLY variables prefixed with VITE_ are exposed to client code
# via import.meta.env.VITE_*. Never put server secrets here — anything
# shipped to the browser bundle is publicly visible.
# =====================================================================

# Public site metadata
VITE_SITE_TITLE="NEUFORM — Structural Intelligence"
VITE_SITE_URL="https://your-domain.example"

# Analytics / integration IDs (public, safe to expose)
VITE_ANALYTICS_ID=""

# Contact / lead endpoint (e.g. Power Automate HTTP trigger URL)
# Keep the true secret behind a backend proxy; only expose if the
# endpoint enforces its own auth/throttling.
VITE_CONTACT_ENDPOINT=""
